# ============================================================
# CLASSGRID PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Copy this to EC2 at /home/ubuntu/classgrid/.env.production
# Replace all placeholder values with actual production secrets
# 
# NEVER commit secrets to git. Use SecretsManager for production.
# ============================================================

# ============================================================
# CORE DEPLOYMENT
# ============================================================
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# ============================================================
# DATABASE
# ============================================================
# Option 1: PostgreSQL (RECOMMENDED for multi-tenant)
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres?schema=public
DATABASE_POOL_SIZE=20

# Option 2: MongoDB (if using MongoDB Atlas instead)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/classgrid?retryWrites=true&w=majority

# Which database to use? 'postgres' or 'mongo'
DB_TYPE=postgres

# ============================================================
# REDIS (For chat, caching, and real-time features)
# ============================================================
REDIS_URL=redis://:password@redis-instance.c246.nde.redis-ent.cloud:11111
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# API GATEWAY & MICROSERVICES
# ============================================================
GATEWAY_PORT=4000
GATEWAY_URL=https://api.classgrid.in

# Service URLs (internal, within EC2)
AUTH_SERVICE_URL=http://localhost:4101
TENANT_SERVICE_URL=http://localhost:4102
PAYMENT_SERVICE_URL=http://localhost:4103
CHAT_SERVICE_URL=http://localhost:4104
NOTES_SERVICE_URL=http://localhost:4105
NOTIFICATION_SERVICE_URL=http://localhost:4106

# ============================================================
# JWT & AUTHENTICATION
# ============================================================
JWT_SECRET=your-super-secret-64-character-random-string-here-do-not-reuse
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=another-super-secret-string-here
JWT_REFRESH_EXPIRY=30d

# ============================================================
# CORS & SECURITY
# ============================================================
CORS_ORIGINS=https://classgrid.in,https://app.classgrid.in,https://*.classgrid.in
CORS_ALLOW_CREDENTIALS=true

# ============================================================
# RAZORPAY (Payment Processing)
# ============================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_ACCOUNT_ID=acc_xxxxx
RAZORPAY_WEBHOOK_SECRET=wehbook_secret_from_razorpay

# ============================================================
# FIREBASE (Push Notifications & Cloud Messaging)
# ============================================================
FIREBASE_PROJECT_ID=classgrid-prod
FIREBASE_PRIVATE_KEY_ID=12345
FIREBASE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@classgrid-prod.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# ============================================================
# EMAIL & NOTIFICATIONS
# ============================================================
# SendGrid or any SMTP service
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@classgrid.in
SENDGRID_FROM_NAME=Classgrid

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+91xxxxxxxxxx

# ============================================================
# SUPABASE (Database + File Storage)
# ============================================================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# AWS S3 (File Storage Alternative)
# ============================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=classgrid-prod
AWS_S3_URL=https://s3.ap-south-1.amazonaws.com/classgrid-prod

# ============================================================
# VERCEL (Marketing & Web App Deployments)
# ============================================================
VERCEL_TOKEN=vercel_token_here
VERCEL_PROJECT_ID_MARKETING=prj_xxx
VERCEL_PROJECT_ID_WEB_APP=prj_xxx

# ============================================================
# SANITY CMS (For Blog, Case Studies, etc.)
# ============================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=skcn_prod_token_here
SANITY_API_VERSION=2023-01-01

# ============================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================
# Zoom
ZOOM_CLIENT_ID=ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=ZOOM_CLIENT_SECRET

# Google Drive / Calendar
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://api.classgrid.in/auth/google/callback

# ============================================================
# MONITORING & LOGGING
# ============================================================
SENTRY_DSN=https://xxxx@sentry.io/xxxx
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# PostHog (Analytics)
POSTHOG_API_KEY=phc_xxxxx
POSTHOG_API_HOST=https://us.posthog.com

# ============================================================
# ADMIN & SUPER ADMIN
# ============================================================
SUPER_ADMIN_EMAIL=admin@classgrid.in
SUPER_ADMIN_PASSWORD=generate-random-secure-password
SUPER_ADMIN_SECRET_TOKEN=super_secret_admin_token

# ============================================================
# FEATURE FLAGS (Enable/disable features in production)
# ============================================================
FEATURE_NAAC_MODULE=false
FEATURE_BIOMETRIC_API=false
FEATURE_REDIS_STREAMS=true
FEATURE_ADVANCED_ANALYTICS=false

# ============================================================
# RATE LIMITING & SECURITY
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# DOMAIN & SSL
# ============================================================
DOMAIN=classgrid.in
API_DOMAIN=api.classgrid.in
APP_DOMAIN=app.classgrid.in
SSL_CERT_PATH=/etc/letsencrypt/live/classgrid.in/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/classgrid.in/privkey.pem

# ============================================================
# TIMEOUTS & PERFORMANCE
# ============================================================
REQUEST_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=5000
REDIS_TIMEOUT_MS=3000

# ============================================================
# DATA RETENTION & CLEANUP
# ============================================================
DEMO_ORG_EXPIRY_DAYS=30
DEMO_ORG_GRACE_PERIOD_DAYS=7
DRAFT_DELETION_WORKER_INTERVAL_HOURS=24

# ============================================================
# META WHATSAPP CLOUD API (marketing site / support webhook)
# ============================================================
# Webhook URL on this app: https://<MARKETING_DOMAIN>/api/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
