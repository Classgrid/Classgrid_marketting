## 6. How to Build This for Classgrid (MongoDB + Node.js)

### What You Need to Store in MongoDB:

**Collection: `students`**
```json
{
  "_id": "ObjectId",
  "registrationNumber": "125B1B028",
  "fullName": "SHINDE NIKHIL SUBHASH",
  "fatherName": "SUBHASH",
  "motherName": "SUNITA",
  "dob": "2007-01-23",
  "program": "B.Tech. Computer Engineering",
  "batchDuration": "2025-2029",
  "abcId": "769536403167",
  "photoUrl": "https://cdn.classgrid.in/photos/125B1B028.jpg"
}
```

**Collection: `courses`**
```json
{
  "_id": "ObjectId",
  "courseCode": "BCE22ES01",
  "courseName": "Object Oriented Programming",
  "courseType": "THEORY",
  "credits": 3,
  "maxMarks": 100,
  "semesterId": 2,
  "academicYear": "2025-26"
}
```

**Collection: `results`**
```json
{
  "_id": "ObjectId",
  "studentId": "ObjectId (ref → students)",
  "courseId": "ObjectId (ref → courses)",
  "academicYear": "2025-26",
  "semester": 2,
  "obtainedMarks": 44,
  "grade": "P",
  "gradePoint": 4,
  "creditEarned": 3,
  "isPass": true,
  "isBacklog": false,
  "createdAt": "2026-06-19T00:00:00Z"
}
```

### Backend API Logic (Node.js Pseudocode):
```javascript
// POST /api/results/grade-card
async function getGradeCard(req, res) {
  // 1. Get student from authenticated session (NOT from request body!)
  const studentId = req.session.studentId;

  // 2. Fetch all results for this student
  const results = await Result.find({ studentId })
    .populate('courseId')
    .sort({ semester: 1 });

  // 3. Group results by semester
  const semesterGroups = groupBy(results, 'semester');

  // 4. Calculate SGPA for each semester
  const sgpaArray = [];
  let totalCredits = 0;
  let totalGradePoints = 0;

  for (const [sem, semResults] of Object.entries(semesterGroups)) {
    const semCredits = sum(semResults.map(r => r.creditEarned));
    const semGP = sum(semResults.map(r => r.creditEarned * r.gradePoint));
    const sgpa = semGP / semCredits;

    totalCredits += semCredits;
    totalGradePoints += semGP;
    const cgpa = totalGradePoints / totalCredits;

    sgpaArray.push({ sem, sgpa, cgpa });
  }

  // 5. Send fully calculated response
  res.json({
    student: { /* identity fields */ },
    results: semesterGroups,
    sgpaArray,
    cgpa: totalGradePoints / totalCredits,
    percentage: ((totalGradePoints / totalCredits) - 0.5) * 10,
    status: "PASS"
  });
}
```

### Key Security Rules for Classgrid:
1. **NEVER** accept `studentId` from the request body — always get it from the authenticated session/JWT
2. Use pre-signed URLs for private files (photos, signatures)
3. Calculate ALL grades/SGPA/CGPA on the server — never trust frontend calculations
4. Use HTTPS with HSTS headers
5. Set `X-Frame-Options` and `X-Content-Type-Options` headers

